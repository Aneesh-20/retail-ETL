# PostgreSQL Warehouse Configuration
DATABASE_URL=postgresql://retail_user:retail_pass@localhost:5432/retail_warehouse
SOURCE_DATABASE_URL=postgresql://retail_user:retail_pass@localhost:5432/retail_source

# Fallback Database Path (if Postgres is not available)
FALLBACK_DB_PATH=./retail_fallback.db

# MinIO / Object Storage Settings
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1
MINIO_BUCKET_BRONZE=lakehouse-bronze
MINIO_BUCKET_SILVER=lakehouse-silver

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CDC=retail_source.public.transactions

# FastAPI Settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
